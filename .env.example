# ============================================================
# CYBERSENTINEL — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to '.env' and populate with your deployment values.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ============================================================

# API Service Configuration
CYBERSENTINEL_API_HOST=0.0.0.0
CYBERSENTINEL_API_PORT=8000
CYBERSENTINEL_API_BASE_URL=http://localhost:8000

# Streamlit SOC Dashboard Configuration
CYBERSENTINEL_DASHBOARD_HOST=0.0.0.0
CYBERSENTINEL_DASHBOARD_PORT=8501

# SOC Database & Storage Paths
# Default WSL2 storage directory: /home/charay/cybersentinel-data/soc
CYBERSENTINEL_SOC_DB_PATH=/home/charay/cybersentinel-data/soc/alerts.db
CYBERSENTINEL_BACKUP_DIR=/home/charay/cybersentinel-data/soc/backups

# Authentication & Access Control (Phase 8)
CYBERSENTINEL_AUTH_ENABLED=true
CYBERSENTINEL_SECRET_KEY=change-in-production-use-a-strong-random-hex-secret
CYBERSENTINEL_TOKEN_EXPIRE_MINUTES=480
CYBERSENTINEL_HASH_ITERATIONS=100000

# Initial SOC Administrator Bootstrap (Optional: Leave blank to use Web Setup)
# Set non-empty values to automatically bootstrap the initial admin on startup.
CYBERSENTINEL_ADMIN_USERNAME=
CYBERSENTINEL_ADMIN_PASSWORD=

# Logging & Operational Telemetry
CYBERSENTINEL_LOG_LEVEL=INFO
